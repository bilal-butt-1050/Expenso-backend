// Expenso — database schema
// One Postgres database, one row of data per user. Every model that holds
// user data carries a `userId` and cascades on delete so removing a user
// cleans up everything they own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  googleId        String?   @unique
  name            String?
  avatarUrl       String?
  currency        String    @default("PKR")
  // IANA zone. Month buckets are derived in the user's own time, not UTC — logging an expense at
  // 2am on the 1st in PKT was landing it in the previous month.
  timezone        String    @default("Asia/Karachi")
  // Bumped on password change and embedded in the JWT, so changing a password actually ends
  // other sessions. Without it a leaked 30-day token outlived the password it was issued under.
  tokenVersion    Int       @default(0)
  // When this account proved it owns its email address (a consumed signup code, or Google).
  // NULL = never proven, which decides what a later Google sign-in may do (D-19, D-22).
  emailVerifiedAt DateTime?
  // The last time the user said what they actually hold (POST /balance), even when no correction
  // was needed. NULL = never, which is when Home asks them to set it (D-55).
  balanceSetAt    DateTime?
  createdAt       DateTime  @default(now())

  categories   Category[]
  expenses     Expense[]
  incomes      Income[]
  budgets      Budget[]
  loans        Loan[]
  transactions Transaction[]

  @@map("users")
}

// A category belongs to exactly one user. Every user gets a set of default
// categories seeded on signup (isDefault = true), and can add their own
// custom ones (isDefault = false) or edit/delete any of them.
model Category {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String   @default("shape-outline") // MaterialCommunityIcons name
  color     String   @default("#00E676")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  expenses     Expense[]
  budgets      Budget[]
  transactions Transaction[]

  @@unique([userId, name])
  @@map("categories")
}

/// DEPRECATED — superseded by `Transaction` with kind = SPEND.
/// Retained so the migration that backfills `transactions` does not drop the source data.
/// Nothing reads or writes this model; it is dropped in a follow-up migration once the unified
/// ledger has been verified in production.
model Expense {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  date          DateTime
  month         String // "YYYY-MM", denormalized for fast month filtering
  description   String?
  amount        Float
  paymentMethod String   @default("Cash")
  needWant      String   @default("Need") // "Need" | "Want"
  status        String   @default("Paid") // All expenses represent settled cashflows ("Paid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, month])
  @@index([userId, categoryId])
  @@map("expenses")
}

/// DEPRECATED — superseded by `Transaction` with kind = EARN. See the note on `Expense`.
model Income {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  month         String // "YYYY-MM"
  source        String // e.g. "Salary", "Freelance", "Business", "Investment", "Bonus", "Rental", "Other"
  sourceIcon    String   @default("cash-multiple")
  sourceColor   String   @default("#00E676")
  description   String?
  amount        Float
  paymentMethod String   @default("Bank Transfer")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, month])
  @@map("incomes")
}

// Standing monthly budget allocations per category.
model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  month      String // "YYYY-MM"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month])
  @@map("budgets")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  // HMAC-SHA256 of email + code, keyed from JWT_SECRET. A database read can't reveal a live code.
  otpHash   String
  // Counted in the database, atomically, before each check: concurrent guesses can't exceed 5.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

/// One row per code sent. The send caps (per email, per IP, global) are counted from here, so a
/// restart can't reset them. Rows older than 48 h are pruned.
model OtpSendLog {
  id        String   @id @default(uuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("otp_send_log")
}

enum LoanType {
  LENT
  BORROWED
}

enum LoanStatus {
  PENDING
  PARTIAL
  SETTLED
}

// Stores records of money lent to others (they owe user) or borrowed from others (user owes them)
model Loan {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          LoanType   @default(LENT)
  personName    String
  amount        Decimal    @db.Decimal(14, 2)
  settledAmount Decimal    @default(0) @db.Decimal(14, 2)
  dueDate       DateTime?
  status        LoanStatus @default(PENDING)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  transactions Transaction[]

  @@index([userId, status])
  @@index([userId, type])
  @@map("loans")
}

/// What a movement of money *is*. This is the distinction the old split between `Expense` and
/// `Income` could not express, and its absence is why lending money and collecting it back
/// invented net worth: creating a loan wrote no cashflow, but settling one wrote income.
///
///   kind       cash   counts as spending   counts as income   linked to a loan
///   SPEND       −           yes                  no                 no
///   EARN        +           no                   yes                no
///   LEND_OUT    −           no                   no                 yes
///   COLLECT     +           no                   no                 yes
///   BORROW_IN   +           no                   no                 yes
///   REPAY       −           no                   no                 yes
///   ADJUST_IN   +           no                   no                 no
///   ADJUST_OUT  −           no                   no                 no
///
/// ADJUST_* are balance corrections (D-55): the difference between what the user says they hold
/// and what the ledger adds up to. They move cash and net worth, never income, spending or a
/// budget, and are deleted rather than edited.
///
/// Cash on hand sums every kind. Budgets and category analytics read SPEND only, so lending a
/// large sum no longer detonates a budget — a transfer is not an expense.
enum TransactionKind {
  SPEND
  EARN
  LEND_OUT
  COLLECT
  BORROW_IN
  REPAY
  ADJUST_IN
  ADJUST_OUT
}

model Transaction {
  id     String          @id @default(uuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   TransactionKind

  // Never Float. Double precision accumulated error across partial settlements.
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime
  // "YYYY-MM", derived in the user's timezone. Denormalized for fast month filtering.
  month  String

  description   String?
  paymentMethod String  @default("Cash")

  // SPEND only.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  needWant   String? // "Need" | "Want"

  // EARN only.
  source      String?
  sourceIcon  String?
  sourceColor String?

  // Set for LEND_OUT / COLLECT / BORROW_IN / REPAY. Cascades so deleting a loan removes its
  // movements, rather than leaving orphaned cashflow behind as the old auto-created rows did.
  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, month, kind])
  // Keyset pagination. Day-level dates make ties the norm, so ordering by date alone made
  // offset paging silently duplicate and drop rows.
  @@index([userId, date, id])
  @@index([userId, categoryId])
  @@index([loanId])
  @@map("transactions")
}
