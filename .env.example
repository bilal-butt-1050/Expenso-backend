PORT=4000
NODE_ENV=development

# Database connection string (PostgreSQL)
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/expenso?schema=public"

# Secret key used for signing JWT tokens
JWT_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="30d"

# Allowed origin for CORS ("*" for local development)
CORS_ORIGIN="*"

# Optional direct connection URL for Prisma migrations
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/expenso?schema=public"

# Optional email OTP service (Resend). If omitted, OTPs log to console in dev.
RESEND_API_KEY=""

# Optional Google OAuth client IDs for Google Sign-In
GOOGLE_CLIENT_ID_WEB=""
GOOGLE_CLIENT_ID_IOS=""
GOOGLE_CLIENT_ID_ANDROID=""

