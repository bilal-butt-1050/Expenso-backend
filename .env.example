PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses your own PostgreSQL install (the one managed in pgAdmin).
# Production uses the Postgres running on the VPS — defined as the `db` service in
# docker-compose.yml — and is configured by the .env that lives on the VPS, not this file.
# Keeping it per-environment means migrations can be proven locally before they ever
# touch production.
#
# Create the local database once:
#   psql -U postgres -c "CREATE DATABASE expenso_dev;"
#
# Then point both URLs at it. DIRECT_URL is what Prisma uses for migrations; with a plain
# local Postgres (no connection pooler in front) it is simply the same URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expenso_dev?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expenso_dev?schema=public"

# Docker (`docker compose up`) only: the `db` service's credentials. Required, with no default: a
# public default password would become the password of any newly created database. Use the same
# password as in DATABASE_URL, which then points at the `db` host:
#   DATABASE_URL="postgresql://expenso:<password>@db:5432/expenso?schema=public"
POSTGRES_USER=expenso
POSTGRES_PASSWORD=
POSTGRES_DB=expenso

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Must be at least 32 characters in production — the server refuses to boot otherwise
# rather than issue forgeable sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="30d"

# Proxies in front of the API that append the caller's address to X-Forwarded-For. 0 (default)
# trusts no forwarded header. Production is behind one nginx, so 1, but ONLY after that nginx block
# sets `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`. Before that, 1 would let any
# client fake its IP and dodge the rate limits. Never "true".
TRUST_PROXY_HOPS=0

# Allowed origin for CORS ("*" for local development)
CORS_ORIGIN="*"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Signup codes are sent through Brevo (brevo.com, free tier: 300 emails/day).
# Leave these empty in local development: with NODE_ENV=development (or test) the code is printed
# to the console instead. In any other environment, missing values make send-otp return 503, and
# the code is never logged.
# The VPS's public IP must be authorised in Brevo (Security > Authorised IPs), or Brevo rejects
# every request.
# Use the *API* key (SMTP & API > API Keys, starts with "xkeysib-"), NOT the SMTP key ("xsmtpsib-"):
# the SMTP key is rejected by the API with "401 Key not found".
BREVO_API_KEY=
# The sender address verified in Brevo (Settings > Senders).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Expenso

# Require a valid emailed code to complete signup.
# Keep this false until BOTH are true: Brevo delivers codes, and the installed mobile app has the
# code-entry step. Turning it on before then locks every new user out of signup.
REQUIRE_EMAIL_VERIFICATION="false"

# ---------------------------------------------------------------------------
# Google Sign-In
# ---------------------------------------------------------------------------
# If all three are empty, Google sign-in is disabled outright — an empty audience list would
# otherwise disable audience checking and accept a token minted for any application.
GOOGLE_CLIENT_ID_WEB=""
GOOGLE_CLIENT_ID_IOS=""
GOOGLE_CLIENT_ID_ANDROID=""
