# Copy to .env.test (untracked) and fill in your local Postgres password.
# Every test run RESETS this database (prisma migrate reset), so it must be a throwaway one.
# tests/setup.ts refuses to run unless the name contains "expenso_test".
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expenso_test?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expenso_test?schema=public"
